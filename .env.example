# Shared HS256 signing key (>= 32 characters). Must match the main API's key.
JWT_SECRET_KEY=
JWT_ISSUER=
JWT_AUDIENCE=
# Comma-separated Work user ids allowed to use Studio. Empty means nobody.
STUDIO_ALLOWED_USER_IDS=
# Comma-separated browser origins allowed by CORS.
CORS_ALLOWED_ORIGINS=
STUDIO_DATA_DIR=/tmp/studio
STUDIO_TTL_HOURS=24
STUDIO_MAX_FILE_GB=3
STUDIO_MAX_PROJECT_GB=10
STUDIO_RENDER_TIMEOUT_MIN=30
STUDIO_QUEUE_MAX=3
PORT=8000
